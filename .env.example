# Copy to .env (git-ignored) only if you want to change a default.
# The local stack runs without a .env file.

# Postgres password for the local container. Local use only.
POSTGRES_PASSWORD=app

# Shown in the app banner and on telemetry as deployment.environment.
APP_ENV=local-otel
APP_VERSION=0.0.1-local

# To point the app at a different database, set one of these and skip the
# postgres and flyway services. See README.md.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
