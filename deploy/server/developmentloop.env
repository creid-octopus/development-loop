# App settings for a server deployment. Octopus replaces every #{...} value at
# deploy time. Never put a real password in this file.
#
# One KEY=VALUE per line. No quotes. systemd and service.sh read the same format.
#
# Octopus variables used:
#   Octopus.Environment.Name
#   Project.Server.Port
#   Project.Postgres.AppHost
#   Project.Postgres.Port
#   Project.Postgres.DatabaseName
#   Project.Postgres.AppRole
#   Project.Postgres.AppPassword   sensitive
APP_ENV=#{Octopus.Environment.Name}
PORT=#{Project.Server.Port}
PGHOST=#{Project.Postgres.AppHost}
PGPORT=#{Project.Postgres.Port}
PGDATABASE=#{Project.Postgres.DatabaseName}
PGUSER=#{Project.Postgres.AppRole}
PGPASSWORD=#{Project.Postgres.AppPassword}
# No Collector on the app servers yet. Turn this off when one is reachable.
OTEL_SDK_DISABLED=true
