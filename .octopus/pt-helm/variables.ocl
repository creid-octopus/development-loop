variable "Project.Postgres.Port" {
    value "5432" {}
}

variable "Project.Postgres.OwnerRole" {
    value "developmentloop_owner_#{Helper.PostgresEnvironmentName}" {}
}

variable "Project.Postgres.AppRole" {
    value "developmentloop_app_#{Helper.PostgresEnvironmentName}" {}
}

variable "Project.Postgres.Host" {
    value "192.168.65.254" {}
}

variable "Project.Postgres.DatabaseName" {
    value "developmentloop_#{Helper.PostgresEnvironmentName}" {}
}

variable "Helper.EnvironmentLowerCase" {
    value "#{Octopus.Environment.Name | ToLower}" {}
}

variable "Helper.PostgresEnvironmentName" {
    value "#{Helper.EnvironmentLowerCase}" {}

    value "helm_#{Helper.EnvironmentLowerCase | Replace \"-\" \"_\"}" {
        environment = ["ephemeral-testing"]
    }
}

variable "Project.Kubernetes.RepositoryUrl" {
    value "https://github.com/creid-octopus/development-loop" {}
}

variable "Project.Kubernetes.RawManifestDirectory" {
    value "k8s/raw/#{Helper.EnvironmentLowerCase}" {}

    value "k8s/raw/ephemeral" {
        environment = ["ephemeral-testing"]
    }
}

variable "Project.Kubernetes.NamespaceName" {
    value "developmentloop-demo-#{Helper.EnvironmentLowerCase}" {}
}

variable "Project.Postgres.AppHost" {
    value "host.docker.internal" {}
}

variable "Project.Ingress.Domain" {
    value "localtest.me" {}
}

variable "Project.Ingress.ClassName" {
    value "nginx" {}
}

variable "Project.Ingress.Port" {
    value "8080" {}
}

variable "Project.Environment.Url" {
    value "http://#{Project.Ingress.Host}#{if Project.Ingress.Port}:#{Project.Ingress.Port}#{/if}" {}
}

variable "Project.Ingress.Host" {
    value "helm-#{Helper.EnvironmentLowerCase}.developmentloop.#{Project.Ingress.Domain}" {}
}

variable "Project.Helm.ReleaseName" {
    value "helm-developmentloop-#{Helper.EnvironmentLowerCase}" {}
}

variable "Project.Helm.ChartDirectory" {
    value "k8s/helm" {}
}

variable "Project.Helm.ValuesFilePath" {
    value "k8s/helm/values-#{Helper.EnvironmentLowerCase}.yaml" {}

    value "k8s/helm/values-ephemeral.yaml" {
        environment = ["ephemeral-testing"]
    }
}

variable "Project.Helm.UpgradeArgs" {
    value "" {}

    value "--set namespace=#{Project.Kubernetes.NamespaceName} --set appEnv=#{Octopus.Environment.Name} --set database.name=#{Project.Postgres.DatabaseName} --set database.user=#{Project.Postgres.AppRole} --set ingress.host=#{Project.Ingress.Host}" {
        environment = ["ephemeral-testing"]
    }
}

variable "Project.Deprovision.Confirm" {
    value "True" {}

    value "False" {
        environment = ["ephemeral-testing"]
    }
}
