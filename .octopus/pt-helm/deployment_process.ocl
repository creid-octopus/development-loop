process_template "predeploy-notification" {
    name = "Predeploy Notification"
    process_template_slug = "notifications-predeploy"
    version_mask = "2.X"

    parameter "Slack.Predeploy.RunEnvs" {
        value = "Environments-4"
    }
}

process_template "verify-database-ready" {
    name = "Verify database ready"
    process_template_slug = "postgres-verify-app-access"
    version_mask = "1.X"

    parameter "Postgres.TargetRole" {
        value = "local-postgres"
    }

    parameter "Postgres.Server.Host" {
        value = "#{Project.Postgres.Host}"
    }

    parameter "Postgres.Server.Port" {
        value = "#{Project.Postgres.Port}"
    }

    parameter "Postgres.Database.Name" {
        value = "#{Project.Postgres.DatabaseName}"
    }

    parameter "Postgres.Database.Owner" {
        value = "#{Project.Postgres.OwnerRole}"
    }

    parameter "Postgres.App.Username" {
        value = "#{Project.Postgres.AppRole}"
    }

    parameter "Postgres.App.Password" {
        value = "#{Project.Postgres.AppPassword}"
    }
}

process_template "run-flyway-migrations" {
    name = "Run Flyway migrations"
    process_template_slug = "postgres-apply-flyway-migrations"
    version_mask = "1.X"

    package_parameter "Postgres.Migrations.Package" {
        feed = "octopus-server-built-in"
        package_id = "developmentloop-flyway"
    }

    parameter "Postgres.Server.Host" {
        value = "#{Project.Postgres.Host}"
    }

    parameter "Postgres.Database.Name" {
        value = "#{Project.Postgres.DatabaseName}"
    }

    parameter "Postgres.Migration.Password" {
        value = "#{Project.Postgres.OwnerPassword}"
    }

    parameter "Postgres.Migration.Username" {
        value = "#{Project.Postgres.OwnerRole}"
    }

    parameter "Postgres.Worker.Pool" {
        value = "WorkerPools-82"
    }

    parameter "Postgres.Review.Policy" {
        value = "risky"
    }
}

process_template "lock-migration-history" {
    name = "Lock migration history"
    process_template_slug = "postgres-lock-migration-history"
    version_mask = "1.X"

    parameter "Postgres.TargetRole" {
        value = "local-postgres"
    }

    parameter "Postgres.Server.Host" {
        value = "#{Project.Postgres.Host}"
    }

    parameter "Postgres.Server.Port" {
        value = "#{Project.Postgres.Port}"
    }

    parameter "Postgres.Database.Name" {
        value = "#{Project.Postgres.DatabaseName}"
    }

    parameter "Postgres.Owner.Username" {
        value = "#{Project.Postgres.OwnerRole}"
    }

    parameter "Postgres.Owner.Password" {
        value = "#{Project.Postgres.OwnerPassword}"
    }

    parameter "Postgres.App.Username" {
        value = "#{Project.Postgres.AppRole}"
    }
}

process_template "create-namespace" {
    name = "Create Namespace"
    process_template_slug = "kubectl-create-namespace"
    version_mask = "PreRelease"

    parameter "Kubectl.CreateNamespace.TargetTag" {
        value = "k8s-agent"
    }

    parameter "Kubectl.CreateNamespace.WorkerPool" {
        value = "WorkerPools-82"
    }

    parameter "Kubectl.CreateNamespace.Name" {
        value = "#{Project.Kubernetes.NamespaceName}"
    }
}

process_template "create-application-secrets" {
    name = "Create application secrets"
    process_template_slug = "kubectl-deploy-manifests-from-git"
    version_mask = "1.X"

    package_parameter "KubernetesYaml.DeploymentImage" {
        feed = "octopus-server-built-in"
        package_id = "octopus_base_package"
        version = "1.0.13"
    }

    parameter "KubernetesYaml.NamespaceTarget" {
        value = "#{Project.Kubernetes.NamespaceName}"
    }

    parameter "KuberenetesYaml.GitRepositoryFilePath" {
        value = "k8s/raw/#{Helper.EnvironmentLowerCase}/secrets/*"
    }

    parameter "KubernetesYaml.GitRepositoryUrl" {
        value = "#{Project.Kubernetes.RepositoryUrl}"
    }

    parameter "KubernetesYaml.TargetTag" {
        value = "k8s-agent"
    }

    parameter "KubernetesYaml.WorkerPool" {
        value = "WorkerPools-82"
    }
}

process_template "deploy-developmentloop" {
    name = "Deploy developmentloop with Helm"
    process_template_slug = "kubernetes-deploy-helm"
    version_mask = "1.X"

    package_parameter "Helm.DeploymentImage" {
        feed = "ghcr-anonymous"
        package_id = "creid-octopus/development-loop"
    }

    parameter "Helm.NamespaceTarget" {
        value = "#{Project.Kubernetes.NamespaceName}"
    }

    parameter "Helm.ReleaseName" {
        value = "#{Project.Helm.ReleaseName}"
    }

    parameter "Helm.GitRepositoryUrl" {
        value = "#{Project.Kubernetes.RepositoryUrl}"
    }

    parameter "Helm.ChartDirectory" {
        value = "#{Project.Helm.ChartDirectory}"
    }

    parameter "Helm.ValuesFilePath" {
        value = "#{Project.Helm.ValuesFilePath}"
    }

    parameter "Helm.TargetTag" {
        value = "k8s-agent"
    }

    parameter "Helm.WorkerPool" {
        value = "WorkerPools-82"
    }
}

process_template "postdeploy-notification" {
    name = "Postdeploy Notification"
    process_template_slug = "notifications-postdeploy"
    version_mask = "5.X"

    parameter "Parameters.CustomMessage" {
        value = "App: #{Project.Environment.Url}"
    }
}

step "show-app-url" {
    name = "Show app URL"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                write_highlight "[Open #{Octopus.Project.Name} in #{Octopus.Environment.Name}](#{Project.Environment.Url})"
                write_highlight "Health check: [#{Project.Environment.Url}/health/db](#{Project.Environment.Url}/health/db)"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool = "local-machine"
    }
}